# Copy to .env.deploy (never committed) and fill in.
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Explicit FTPS (recommended). Set to false only if your host does not support it.
FTP_SECURE=true

# Folder that mail.example.com points to.
REMOTE_WEBROOT=/domains/example.com/public_html/mail
# Application code, outside the web root.
REMOTE_APPDIR=/domains/example.com/postvak-app
